# Copy to .env (chmod 600). Never commit .env.
WEB_SECRET=            # long random string: signs the web app's sign-in cookies (python -c "import secrets; print(secrets.token_urlsafe(32))")
SEC_USER_AGENT=        # SEC EDGAR asks for "Name contact@example.com" in the User-Agent
FRED_API_KEY=          # optional: macro data (fred.stlouisfed.org)
FINNHUB_API_KEY=       # optional: news and earnings calendar (finnhub.io)
